+        new = np.arange(start, start + int(chunk_len), dtype=np.int32)
+        prev_all = state.retained_positions or {}
+        out: dict[tuple[int, int], np.ndarray] = {}
+        for key, keep in keeps.items():
+            prev = prev_all.get(key)
+            cols = keep.shape[0] if keep is not None else (
+                prev.shape[0] if prev is not None else 1)
+            appended = np.broadcast_to(new, (cols, new.shape[0]))
+            before = appended if prev is None else np.concatenate(
+                [prev, appended], axis=1)
