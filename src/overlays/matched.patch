+def _ragged_immutable_prefix(metadata, num_layers: int,
+                            num_groups: int) -> "np.ndarray | None":
+    """The ragged base's per-(layer, group) prefix lengths, or None for a uniform one.
+
+    The scheduler sends a flat tuple rather than an array because the payload crosses a process
+    boundary in a multiprocess engine. The shape is recovered and validated here: a silently
+    mis-shaped prefix would protect the wrong slots rather than fail, and the whole point of the
+    protection is that it cannot be got wrong quietly.
+    """
+    flat = getattr(metadata, "immutable_prefix_lengths", None)
+    if not flat:
+        return None
+    array = np.asarray(flat, dtype=np.int32)
+    if array.size != num_layers * num_groups:
+        raise RuntimeError(
+            f"ragged immutable prefix has {array.size} lengths, expected "
+            f"{num_layers * num_groups} for ({num_layers}, {num_groups})")
+    if np.any(array <= 0):
+        raise RuntimeError("ragged immutable prefix lengths must all be positive")
+    return array.reshape(num_layers, num_groups)
