+    def resume_immutable_prefix(
+        self,
+        req_id: str,
+        kept_lengths: np.ndarray,
+    ) -> None:
+        """Seed Tangram's ratio lifecycle from a KVLadder prefix hit.
+
+        The shared compact prefix is already the result of a committed
+        compression boundary. Its exact physical length becomes the previous
+        kept length; no scorer state for the immutable prefix is recreated.
+        The scheduler protects that prefix as a sink and the executor skips its
+        block-aligned writeback, so only newly appended private KV is mutable.
+        """
+        if self.regime.name != "ratio":
+            raise RuntimeError(
+                "immutable-prefix resume supports Tangram's lock-in ratio "
+                "regime only; the budget regime globally reselects old slots"
+            )
+        lengths = np.asarray(kept_lengths, dtype=np.int32)
+        expected = (self.num_layers, self.num_head_groups_per_layer)
+        if lengths.shape != expected or np.any(lengths <= 0):
+            raise ValueError(
+                f"immutable prefix lengths {lengths.shape} do not match {expected}"
+            )
+        self.begin_request(req_id)
+        state = self.req_state[req_id]
+        state.has_committed = True
+        state.cached_kept_lengths_cpu = lengths.copy()
+        self.workspace.valid_lengths[state.row].copy_(
+            torch.from_numpy(lengths.astype(np.int64))
+        )
+        self.workspace.locked[state.row].zero_()
+
     def end_request(self, req_id: str) -> None:
         # Idempotent for worker shutdown paths. Releasing the row is what keeps
         # the fixed row pool from leaking across a long-running engine.
